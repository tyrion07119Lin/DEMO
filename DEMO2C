<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>東元資融 消費者端行動 App - 第一版原型</title>
  <style>
    :root {
      --primary: #1E40AF;
      --primary-light: #3B82F6;
      --accent: #F59E0B;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --text: #0F172A;
      --text-muted: #64748B;
      --border: #E2E8F0;
      --green: #10B981;
      --red: #EF4444;
      --purple: #6366F1;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
    
    body {
      background-color: #0B0F19;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      color: var(--text);
    }

    /* 頂部情境切換控制器 (會議展示專用：純消費者視角) */
    .control-header {
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(10px);
      width: 100%;
      padding: 12px 10px;
      display: flex;
      justify-content: center;
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .control-panel {
      display: flex;
      gap: 10px;
      max-width: 420px;
      width: 100%;
    }
    .ctrl-btn {
      flex: 1;
      padding: 8px 12px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 20px;
      background: rgba(255,255,255,0.05);
      color: #94A3B8;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s;
      text-align: center;
    }
    .ctrl-btn.active {
      background: var(--primary-light);
      color: white;
      border-color: var(--primary-light);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    /* 手機外框容器 */
    .phone-wrapper {
      margin: 20px 0 40px 0;
      width: 390px;
      height: 844px;
      background: var(--bg);
      border-radius: 48px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 10px #1E293B;
      position: relative;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    @media (max-width: 500px) {
      body { background-color: var(--bg); }
      .phone-wrapper {
        margin: 0;
        width: 100vw;
        height: calc(100vh - 55px);
        border-radius: 0;
        box-shadow: none;
      }
    }

    /* 頂部動態島與狀態列 */
    .status-bar {
      height: 44px;
      background: var(--card-bg);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 24px;
      font-size: 13px;
      font-weight: 600;
      z-index: 20;
      flex-shrink: 0;
      border-bottom: 1px solid rgba(0,0,0,0.03);
    }
    .status-bar .notch {
      width: 100px;
      height: 22px;
      background: #000;
      border-radius: 20px;
    }

    /* 常駐 App 頂部 Bar */
    .app-top-header {
      height: 48px;
      background: white;
      padding: 0 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
      z-index: 15;
    }
    .app-brand {
      font-size: 17px;
      font-weight: 900;
      color: var(--primary);
      letter-spacing: 0.5px;
    }
    .bell-icon-btn {
      position: relative;
      cursor: pointer;
      font-size: 20px;
      padding: 4px;
    }
    .bell-badge {
      position: absolute;
      top: 0px;
      right: 0px;
      background: var(--red);
      color: white;
      font-size: 10px;
      font-weight: 800;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid white;
    }

    /* 浮動客服按鈕 */
    .support-fab {
      position: absolute;
      bottom: 75px;
      right: 16px;
      background: linear-gradient(135deg, #1E40AF, #3B82F6);
      color: white;
      border-radius: 28px;
      padding: 9px 13px;
      display: flex;
      align-items: center;
      gap: 5px;
      box-shadow: 0 8px 18px rgba(30, 64, 175, 0.35);
      cursor: pointer;
      z-index: 40;
      font-size: 12px;
      font-weight: 700;
      border: 1px solid rgba(255,255,255,0.2);
    }

    /* App 主滑動區域 */
    .app-screen {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      display: none;
      padding-bottom: 85px;
    }
    .app-screen.active { display: block; }

    /* 通用卡片 */
    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
      border: 1px solid var(--border);
    }
    .card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* 輪播橫幅 */
    .carousel-container {
      position: relative;
      width: 100%;
      height: 136px;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 14px;
      box-shadow: 0 4px 12px rgba(30, 64, 175, 0.12);
    }
    .carousel-track {
      display: flex;
      width: 300%;
      height: 100%;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .carousel-slide {
      width: 33.333%;
      height: 100%;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: white;
      cursor: pointer;
    }
    .carousel-indicators {
      position: absolute;
      bottom: 8px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      gap: 5px;
    }
    .indicator-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: rgba(255,255,255,0.4);
      transition: all 0.2s;
    }
    .indicator-dot.active {
      width: 14px;
      border-radius: 8px;
      background: white;
    }

    /* 徽章與按鈕 */
    .badge { padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; display: inline-block; }
    .badge-blue { background: #DBEAFE; color: #1E40AF; }
    .badge-orange { background: #FEF3C7; color: #B45309; }
    .badge-green { background: #D1FAE5; color: #065F46; }
    .badge-red { background: #FEE2E2; color: #991B1B; }
    .badge-gray { background: #F1F5F9; color: #475569; }

    .btn-main {
      width: 100%;
      background: var(--primary);
      color: white;
      border: none;
      padding: 11px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: opacity 0.2s;
    }
    .btn-main:active { opacity: 0.85; }
    .btn-sec {
      background: #EFF6FF;
      color: var(--primary);
      border: 1px solid #BFDBFE;
    }

    /* 二級分頁標籤 (Tabs) */
    .sub-tab-bar {
      display: flex;
      background: #F1F5F9;
      padding: 3px;
      border-radius: 10px;
      margin-bottom: 12px;
    }
    .sub-tab-item {
      flex: 1;
      text-align: center;
      padding: 7px;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      border-radius: 8px;
      cursor: pointer;
    }
    .sub-tab-item.active {
      background: white;
      color: var(--primary);
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    /* 條目與列表 */
    .item-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 10px;
    }

    /* 底部導覽列 (銀角零卡架構：首頁、交易管理、帳單繳款、我的) */
    .nav-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 65px;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding-bottom: 6px;
      z-index: 30;
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 10px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      flex: 1;
    }
    .nav-item.active { color: var(--primary); font-weight: 700; }
    .nav-icon { font-size: 18px; margin-bottom: 2px; }

    /* 彈窗遮罩 */
    .modal-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(4px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 200;
      padding: 18px;
    }
    .modal-content {
      background: white;
      border-radius: 22px;
      padding: 20px 16px;
      width: 100%;
      max-height: 88%;
      overflow-y: auto;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
      animation: popIn 0.25s ease-out;
    }
    @keyframes popIn {
      from { transform: scale(0.92); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .form-group-row { display: flex; align-items: center; margin-bottom: 10px; text-align: left; }
    .form-label { width: 90px; font-size: 12px; font-weight: 700; color: #334155; flex-shrink: 0; }
    .form-control { width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; outline: none; }
  </style>
</head>
<body>

  <!-- 頂部情境控制器 (會議 Demo 專用切換：未登入訪客 vs 會員嘟嘟) -->
  <header class="control-header">
    <div class="control-panel">
      <button class="ctrl-btn active" onclick="switchUserMode('guest')">情境 1：訪客 (未登入/新客)</button>
      <button class="ctrl-btn" onclick="switchUserMode('member')">情境 2：會員 (嘟嘟/已認領合約)</button>
    </div>
  </header>

  <!-- 手機外框 -->
  <main class="phone-wrapper">
    <div class="status-bar">
      <span>09:41</span>
      <div class="notch"></div>
      <span>5G 85%</span>
    </div>

    <!-- 常駐頂部導航 -->
    <div class="app-top-header">
      <div class="app-brand" id="topHeaderBrand">東元資融</div>
      <div class="bell-icon-btn" onclick="openModal('notification-modal')">
        🔔
        <span class="bell-badge" id="bellBadge" style="display: none;">2</span>
      </div>
    </div>

    <!-- 浮動客服按鈕 (純 C 端客服：支援常見問題與轉接 LINE/專人) -->
    <div class="support-fab" onclick="openModal('support-modal')">
      <span>💬</span>
      <span>智能客服</span>
    </div>

    <!-- ==========================================
         頁面 1：首頁 (Home)
         ========================================== -->
    <section id="tab-screen-home" class="app-screen active">
      
      <!-- 訪客狀態提示卡片 -->
      <div id="homeGuestBanner" class="card" style="background: linear-gradient(135deg, #1E3A8A, #3B82F6); color: white; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="font-size: 15px; font-weight: 800;">歡迎來到東元資融</div>
          <div style="font-size: 11px; opacity: 0.9; margin-top: 2px;">登入或認領帳戶，即享跨品牌查繳</div>
        </div>
        <button class="badge" style="background: white; color: var(--primary); padding: 6px 12px; cursor: pointer; border: none;" onclick="openModal('login-modal')">登入 / 註冊</button>
      </div>

      <!-- 會員狀態：額度與問候卡片 (銀角零卡獨立頂部額度) -->
      <div id="homeMemberCard" class="card" style="background: linear-gradient(135deg, #0F172A, #1E293B); color: white; display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <div style="font-size: 12px; opacity: 0.8;">嘟嘟 您好 👋 (已認證)</div>
          <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34D399;">正常履約中</span>
        </div>
        <div style="font-size: 11px; opacity: 0.7;">目前可用額度</div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 2px;">
          <div style="font-size: 26px; font-weight: 900; color: #60A5FA;">NT$ 45,000</div>
          <div style="font-size: 11px; opacity: 0.7;">總額度 $60,000</div>
        </div>
        <div style="background: rgba(255,255,255,0.15); height: 5px; border-radius: 4px; margin: 8px 0;">
          <div style="background: var(--green); width: 75%; height: 100%; border-radius: 4px;"></div>
        </div>
        <div style="font-size: 10px; color: #CBD5E1; display: flex; justify-content: space-between;">
          <span>⭐ 連續正常繳納累積信用，定期自動提額</span>
          <a href="javascript:void(0)" style="color: #93C5FD; text-decoration: none;" onclick="alert('額度提額申請：請補傳近 3 個月薪資存摺影本。')">申請提額 ›</a>
        </div>
      </div>

      <!-- 促銷與重要公告輪播 Banner (取代簡訊成本) -->
      <div class="carousel-container" onclick="handleBannerClick()">
        <div class="carousel-track" id="bannerTrack">
          <div class="carousel-slide" style="background: linear-gradient(135deg, #1E3A8A, #2563EB);">
            <div>
              <span class="badge" style="background: rgba(255,255,255,0.25); color: white; margin-bottom: 6px;">舊客權益</span>
              <div style="font-size: 15px; font-weight: 800; line-height: 1.3;">已有線下合約？<br>線上認領帳戶即享 App 繳款推播</div>
            </div>
            <div style="font-size: 11px; opacity: 0.9;">點擊立即綁定 ›</div>
          </div>
          <div class="carousel-slide" style="background: linear-gradient(135deg, #047857, #10B981);">
            <div>
              <span class="badge" style="background: rgba(255,255,255,0.25); color: white; margin-bottom: 6px;">便民服務</span>
              <div style="font-size: 15px; font-weight: 800; line-height: 1.3;">跨品牌合併繳款新上線<br>四大超商與 ATM 轉帳免手續費</div>
            </div>
            <div style="font-size: 11px; opacity: 0.9;">了解繳款方式 ›</div>
          </div>
          <div class="carousel-slide" style="background: linear-gradient(135deg, #B45309, #F59E0B);">
            <div>
              <span class="badge" style="background: rgba(255,255,255,0.25); color: white; margin-bottom: 6px;">官方重要公告</span>
              <div style="font-size: 15px; font-weight: 800; line-height: 1.3;">防範偽冒分期詐騙手法<br>官方繳款與對帳請一律認明 App</div>
            </div>
            <div style="font-size: 11px; opacity: 0.9;">查看防詐須知 ›</div>
          </div>
        </div>
        <div class="carousel-indicators">
          <div class="indicator-dot active" id="dot0"></div>
          <div class="indicator-dot" id="dot1"></div>
          <div class="indicator-dot" id="dot2"></div>
        </div>
      </div>

      <!-- 快捷入口專區 (銀角零卡獨立入口設計：信貸、進度、繳費) -->
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 14px;">
        <div class="card" style="padding: 12px 8px; text-align: center; margin-bottom: 0; cursor: pointer;" onclick="switchTab('billing')">
          <div style="font-size: 22px; margin-bottom: 2px;">🧾</div>
          <div style="font-size: 12px; font-weight: 700;">當期帳單</div>
          <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">9/20 截止</div>
        </div>
        <div class="card" style="padding: 12px 8px; text-align: center; margin-bottom: 0; cursor: pointer;" onclick="switchTab('tx')">
          <div style="font-size: 22px; margin-bottom: 2px;">⏳</div>
          <div style="font-size: 12px; font-weight: 700;">申辦進度</div>
          <div style="font-size: 10px; color: var(--orange); margin-top: 2px;" id="pendingTxCount">1 件補件中</div>
        </div>
        <div class="card" style="padding: 12px 8px; text-align: center; margin-bottom: 0; cursor: pointer;" onclick="openModal('loan-entry-modal')">
          <div style="font-size: 22px; margin-bottom: 2px;">💰</div>
          <div style="font-size: 12px; font-weight: 700;">小額信貸</div>
          <div style="font-size: 10px; color: var(--primary); margin-top: 2px;">線上速審</div>
        </div>
      </div>

      <!-- 本期即刻應繳提醒 (弱化品牌，強調買了什麼與幾號要繳) -->
      <div class="card" style="border-left: 4px solid var(--primary);">
        <div class="card-title">本期應繳項目 (9/20 繳款截止) <span style="color: var(--red); font-size: 11px;">剩 6 天</span></div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin: 4px 0 10px 0;">
          <div style="font-size: 24px; font-weight: 900;">NT$ 8,250</div>
          <div style="font-size: 11px; color: var(--text-muted);">共 3 筆消費項目</div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn-main" onclick="openPaymentBarcode()">出示繳款條碼</button>
          <button class="btn-main btn-sec" onclick="copyVirtualAccount()">ATM 轉帳帳號</button>
        </div>
      </div>

    </section>

    <!-- ==========================================
         頁面 2：交易管理 (Transactions - 參考銀角零卡切分)
         ========================================== -->
    <section id="tab-screen-tx" class="app-screen">
      <div class="sub-tab-bar">
        <div class="sub-tab-item active" id="subTabPending" onclick="switchTxSubTab('pending')">進行中 / 審核中 (2)</div>
        <div class="sub-tab-item" id="subTabHistory" onclick="switchTxSubTab('history')">歷史交易紀錄 (3)</div>
      </div>

      <!-- 進行中列表 (店家確認中、徵審中、待補件) -->
      <div id="txPendingList">
        <div class="item-card" style="border-left: 3px solid var(--red);">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <span style="font-size: 11px; color: var(--text-muted);">進件編號 #TX20260920-01</span>
            <span class="badge badge-red">待補充資料</span>
          </div>
          <div style="font-size: 14px; font-weight: 800;">光陽機車分期換購項目</div>
          <div style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">申請金額：NT$ 68,000 (24期)</div>
          <div style="background: #FEF2F2; border-radius: 8px; padding: 8px 10px; font-size: 11px; color: #991B1B; margin: 6px 0;">
            ⚠️ 徵審照會提示：第二證件健保卡拍照反光，請點擊下方按鈕補傳照片以利加速放款。
          </div>
          <button class="btn-main" style="background: var(--purple); padding: 7px; font-size: 12px;" onclick="openModal('upload-doc-modal')">📷 線上拍照補件</button>
        </div>

        <div class="item-card" style="border-left: 3px solid var(--accent);">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <span style="font-size: 11px; color: var(--text-muted);">進件編號 #TX20260918-09</span>
            <span class="badge badge-orange">特約店家確認中</span>
          </div>
          <div style="font-size: 14px; font-weight: 800;">毛孩健康動物醫療分期</div>
          <div style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">申請金額：NT$ 18,000 (12期)</div>
          <div style="font-size: 11px; color: var(--text-muted);">徵審已核准，待門市確認施作療程即可交付。</div>
        </div>
      </div>

      <!-- 歷史交易紀錄 (已核准分期履約中、已清償、婉拒附原因) -->
      <div id="txHistoryList" style="display: none;">
        <div class="item-card">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <span style="font-size: 11px; color: var(--text-muted);">2026/08/10 核准</span>
            <span class="badge badge-green">履約中 (14/24期)</span>
