          <span style="font-size: 12px; cursor: pointer; color: var(--text-muted);" onclick="closeModal('support-modal')">✕ 關閉</span>
        </div>
        <div style="background: #F8FAFC; border-radius: 10px; padding: 10px; font-size: 11px; margin-bottom: 10px;">
          <strong>常見問題快速查看：</strong><br>
          • <a href="javascript:void(0)" onclick="alert('合併繳款支援 ATM 轉帳自動分帳；超商條碼可直接出示當期彙整條碼刷付。')">超商與 ATM 如何合併繳費？</a><br>
          • <a href="javascript:void(0)" onclick="alert('繳費後約需 1~2 個工作天超商銷帳；若有急需可利用「上傳收據」功能。')">超商繳費後多久入帳？</a><br>
          • <a href="javascript:void(0)" onclick="alert('點選進行中交易，即可查看缺件並直接拍照補傳。')">審核未過或缺少文件如何補傳？</a>
        </div>
        <div style="text-align: center; margin-top: 14px;">
          <button class="btn-main" style="background: #059669; font-size: 12px; padding: 9px;" onclick="alert('正在為您導引至官方一對一 LINE 專人客服：@teco_finance')">
            轉接真人 LINE 專人客服 (@teco_finance)
          </button>
          <div style="font-size: 10px; color: var(--text-muted); margin-top: 6px;">免付費客服專線：0800-000-888 (平日 09:00 - 18:00)</div>
        </div>
      </div>
    </div>

    <!-- 8. 線上拍照補件彈窗 -->
    <div id="upload-doc-modal" class="modal-overlay" onclick="closeModal('upload-doc-modal')">
      <div class="modal-content" onclick="event.stopPropagation()" style="text-align: left;">
        <h3 style="font-size: 15px; font-weight: 800; margin-bottom: 4px;">📷 線上拍照補件</h3>
        <p style="font-size: 11px; color: var(--text-muted); margin-bottom: 12px;">請針對審查提示之缺件項目進行拍照上傳</p>
        
        <div class="form-group-row">
          <div class="form-label">補件項目</div>
          <select class="form-control">
            <option>第二證件 (健保卡正面照)</option>
            <option>近三個月薪資證明 / 存摺封面</option>
            <option>戶籍地址變更證明文件</option>
          </select>
        </div>

        <div style="border: 2px dashed #CBD5E1; border-radius: 12px; padding: 18px; text-align: center; background: #F8FAFC; cursor: pointer; margin-bottom: 12px;" onclick="alert('已模擬開啟鏡頭完成健保卡正面拍照')">
          <div style="font-size: 26px;">📸</div>
          <div style="font-size: 12px; font-weight: 700; color: var(--primary);">點擊啟動相機拍攝照片</div>
          <div style="font-size: 10px; color: var(--text-muted);">請避免反光與邊緣遮蔽</div>
        </div>

        <button class="btn-main" onclick="closeModal('upload-doc-modal'); alert('補件照片已上傳成功！徵審人員將於 2 小時內重新複核。');">確認送出補件</button>
      </div>
    </div>

    <!-- 9. 訊息推播通知彈窗 (取代簡訊通知) -->
    <div id="notification-modal" class="modal-overlay" onclick="closeModal('notification-modal')">
      <div class="modal-content" onclick="event.stopPropagation()" style="text-align: left;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <h3 style="font-size: 15px; font-weight: 800;">🔔 系統推播通知</h3>
          <span style="font-size: 11px; color: var(--primary); cursor: pointer;" onclick="markAllRead()">全部已讀</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 10px; padding: 10px; font-size: 11px;">
            <div style="font-weight: 800; color: #166534; margin-bottom: 2px;">⚠️ 繳款到期前 7 天推播提醒</div>
            <div style="color: #374151;">您本期合併應繳金額 NT$ 8,250 繳款截止日為 9/20，點此開啟超商繳款碼。</div>
            <div style="color: #9CA3AF; font-size: 10px; margin-top: 4px;">今天 09:00</div>
          </div>
          <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 10px; padding: 10px; font-size: 11px;">
            <div style="font-weight: 800; color: #1E40AF; margin-bottom: 2px;">✅ 信用額度調升通知</div>
            <div style="color: #374151;">感謝您連續 6 期準時履約，您的可用額度已由 $35,000 自動調升至 $45,000！</div>
            <div style="color: #9CA3AF; font-size: 10px; margin-top: 4px;">昨天 14:20</div>
          </div>
        </div>
        <button class="btn-main" style="margin-top: 12px;" onclick="closeModal('notification-modal')">關閉</button>
      </div>
    </div>

  </main>

  <script>
    // 使用者狀態模式：'guest' (訪客/未登入), 'member' (會員已認證)
    let currentMode = 'member';
    let currentTab = 'home';

    // 情境切換 (頂部展示列)
    function switchUserMode(mode) {
      currentMode = mode;
      document.querySelectorAll('.ctrl-btn').forEach(btn => btn.classList.remove('active'));
      
      const guestBanner = document.getElementById('homeGuestBanner');
      const memberCard = document.getElementById('homeMemberCard');
      const bellBadge = document.getElementById('bellBadge');
      const profileName = document.getElementById('profileNameDisplay');
      const profilePhone = document.getElementById('profilePhoneDisplay');
      const profileAuthBtn = document.getElementById('profileAuthBtn');

      if (mode === 'guest') {
        document.querySelectorAll('.ctrl-btn')[0].classList.add('active');
        guestBanner.style.display = 'flex';
        memberCard.style.display = 'none';
        bellBadge.style.display = 'none';
        profileName.innerText = '訪客 (未登入)';
        profilePhone.innerText = '請登入以查看合約與帳單';
        profileAuthBtn.innerText = '立即登入 / 認領合約';
        profileAuthBtn.style.color = 'var(--primary)';
        profileAuthBtn.style.borderColor = '#BFDBFE';
      } else {
        document.querySelectorAll('.ctrl-btn')[1].classList.add('active');
        guestBanner.style.display = 'none';
        memberCard.style.display = 'block';
        bellBadge.style.display = 'flex';
        profileName.innerText = '嘟嘟';
        profilePhone.innerText = '0912-***-678';
        profileAuthBtn.innerText = '安全登出';
        profileAuthBtn.style.color = 'var(--red)';
        profileAuthBtn.style.borderColor = '#FECACA';
      }
    }

    // 底部頁籤切換
    function switchTab(tabId) {
      currentTab = tabId;
      document.querySelectorAll('.app-screen').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

      document.getElementById(`tab-screen-${tabId}`).classList.add('active');
      document.getElementById(`nav-${tabId}`).classList.add('active');

      const brandEl = document.getElementById('topHeaderBrand');
      if (tabId === 'home') brandEl.innerText = '東元資融';
      else if (tabId === 'tx') brandEl.innerText = '交易管理';
      else if (tabId === 'billing') brandEl.innerText = '帳單繳款中心';
      else if (tabId === 'profile') brandEl.innerText = '我的帳戶';
    }

    // 交易管理二級頁籤切換
    function switchTxSubTab(sub) {
      document.querySelectorAll('.sub-tab-item').forEach(el => el.classList.remove('active'));
      if (sub === 'pending') {
        document.getElementById('subTabPending').classList.add('active');
        document.getElementById('txPendingList').style.display = 'block';
        document.getElementById('txHistoryList').style.display = 'none';
      } else {
        document.getElementById('subTabHistory').classList.add('active');
        document.getElementById('txPendingList').style.display = 'none';
        document.getElementById('txHistoryList').style.display = 'block';
      }
    }

    // 條碼彈窗控制 (支援合併與單筆)
    function openPaymentBarcode() {
      document.getElementById('barcodeModalTitle').innerText = '全產品合併本期應繳 (3 筆合計)';
      document.getElementById('barcodeModalAmount').innerText = 'NT$ 8,250';
      openModal('barcode-modal');
    }

    function openSingleBarcode(name, amt) {
      document.getElementById('barcodeModalTitle').innerText = `單筆繳納：${name}`;
      document.getElementById('barcodeModalAmount').innerText = `NT$ ${amt.toLocaleString()}`;
      openModal('barcode-modal');
    }

    // ATM 虛擬帳號一鍵複製 (系統自動分帳)
    function copyVirtualAccount() {
      const acc = '98234-8821-9923';
      navigator.clipboard.writeText(acc.replace(/-/g, '')).then(() => {
        alert(`已複製玉山銀行專屬虛擬轉帳帳號：${acc}\n\n本帳號支援全額一次轉入，東元資融金流系統將自動為您分帳沖銷 3 筆合約。`);
      }).catch(() => {
        alert(`玉山銀行虛擬帳號：${acc}`);
      });
    }

    // 輪播 Banner 點擊處理
    function handleBannerClick() {
      if (currentMode === 'guest') {
        openModal('login-modal');
      } else {
        switchTab('billing');
      }
    }

    // 會員登入成功處理
    function executeLoginSuccess() {
      closeModal('login-modal');
      switchUserMode('member');
      alert('🎉 登入成功！已為您自動關聯並歸戶 3 筆線下既有合約。');
    }

    // 個人中心登入/登出按鈕
    function handleAuthAction() {
      if (currentMode === 'guest') {
        openModal('login-modal');
      } else {
        if (confirm('確定要安全登出東元資融 App 嗎？')) {
          switchUserMode('guest');
          alert('您已安全登出。');
        }
      }
    }

    // Modal 控制器
    function openModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function markAllRead() {
      document.getElementById('bellBadge').style.display = 'none';
      alert('已將所有通知標示為已讀！');
      closeModal('notification-modal');
    }

    // 輪播橫幅自動旋轉 (3.5 秒)
    let currentSlide = 0;
    const totalSlides = 3;
    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      const track = document.getElementById('bannerTrack');
      if (track) {
        track.style.transform = `translateX(-${currentSlide * (100 / totalSlides)}%)`;
        for (let i = 0; i < totalSlides; i++) {
          const dot = document.getElementById(`dot${i}`);
          if (dot) dot.classList.toggle('active', i === currentSlide);
        }
      }
    }
    setInterval(nextSlide, 3500);

    // 預設進入已登入展示模式
    switchUserMode('member');
  </script>
</body>
</html>
